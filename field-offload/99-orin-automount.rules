# Auto-mount: when THIS SSD is plugged in, mount it at /mnt/usb (no copy).
#
# Matched by filesystem UUID, which is unique to this specific drive. (We do NOT
# match by label: this SanDisk's label "Extreme SSD" is the factory default that
# every Extreme ships with, so it wouldn't be unique.) Works no matter which
# /dev/sdX the drive lands on.
#
# udev must not run long tasks itself (it kills them), so we hand off to systemd
# via SYSTEMD_WANTS - the service runs the mount script.
#
# The UUID changes only if you reformat the drive. Find it with `lsblk -f`, and
# if it changes, update it here AND in orin-automount.sh.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="5E64-018F", TAG+="systemd", ENV{SYSTEMD_WANTS}="orin-automount.service"
